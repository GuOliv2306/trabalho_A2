# ================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ================================
# 🤖 OpenAI API (obrigatório para relatórios com IA)
# ================================
OPENAI_API_KEY=sk-proj-your-key-here

# ================================
# 🔒 Segurança - Endpoint Administrativo
# ================================
# Chave para proteger /api/v1/admin/populate-database
# Gere uma chave forte: openssl rand -hex 32
# Se não configurar, endpoint funcionará SEM proteção (inseguro em produção!)
ADMIN_KEY=sua_chave_secreta_forte_aqui

# ================================
# 🗄️ Database Configuration
# ================================
# Desenvolvimento: DuckDB (arquivo local)
DATABASE_PATH=data/processed/ga4_data.duckdb

# Produção: PostgreSQL (descomentar e configurar URL do Render)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ================================
# 🚀 API Configuration
# ================================
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# 📊 Report Generation Settings
# ================================
REPORT_CACHE_TTL=3600
REPORT_MAX_REQUESTS_PER_HOUR=5

# Agno Configuration
AGNO_DEBUG_MODE=False

# ================================
# 📝 Logging
# ================================
LOG_LEVEL=INFO

# ================================
# 🔗 Legacy (se ainda usar APIs reais)
# ================================
GA_VIEW_ID=seu_id

